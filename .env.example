# Copy to .env for plain `docker compose`, or enter these as stack environment variables in
# Portainer / Dockhand. Never commit the filled-in file (.env is in .gitignore).

# ---------------------------------------------------------------- required
# The manager GUI and the Traefik dashboard (/dashboard/). Must be inside ALLOWED_DOMAINS.
MANAGER_FQDN=traefik.lab.example.com
# Apps can only use names under these domains (comma-separated)
ALLOWED_DOMAINS=lab.example.com
# Your LAN. The manager, and apps with "LAN only" ticked, only answer clients from here
LAN_CIDRS=192.168.1.0/24

# ---------------------------------------------------------------- host
# This host's LAN IP. App names should resolve to it; the DNS check warns when they don't
HOST_IP=192.168.1.10
TZ=UTC
# Host folder for config, certs, data and logs
TM_ROOT=/opt/traefik
# Host folder holding intermediate/ (cert + key) and root/ (root cert only)
PKI_DIR=/opt/traefik/pki
# Break-glass access to the manager that bypasses Traefik. Use <lan-ip>:8090 to listen on one address
BREAK_GLASS_PORT=8090
# Docker network shared with your apps (create it once: docker network create proxy)
PROXY_NETWORK=proxy

# ---------------------------------------------------------------- internal CA
# Nothing to do: on first start the manager creates a CA for ALLOWED_DOMAINS in PKI_DIR.
# Optional: a password to encrypt the CA key with (needed on every start once set)
CA_KEY_PASSWORD=
# To use a CA you already have, put it in PKI_DIR and name the files here
CA_CERT_FILE=intermediate_ca.crt
CA_KEY_FILE=intermediate_ca_key
ROOT_CA_FILE=root_ca.crt
# true (default), false, or force (create a new CA even though apps hold certs from an old one)
CA_AUTO_CREATE=true

# ---------------------------------------------------------------- manager image
# Pin to a release (e.g. 1.0.0) to choose when you upgrade
TM_VERSION=latest
# TM_IMAGE=ghcr.io/gjerdingc/traefik-manager

# ---------------------------------------------------------------- GUI login (recommended)
# Turn it on in the GUI under Settings. Or set it here instead, which overrides Settings:
# htpasswd entries, e.g. from: htpasswd -nB me   (in .env, write each $ as $$)
BASIC_AUTH_USERS=
# true removes the login set under Settings at startup (forgotten password); remove it afterwards
# RESET_LOGIN=true

# Traffic page: every request and sign-in, with IP addresses and who did what, kept this many days (0 = off)
# TRAFFIC_RETENTION_DAYS=30

# ---------------------------------------------------------------- Let's Encrypt (optional)
LETSENCRYPT_ENABLED=false
ACME_EMAIL=
# Staging while testing (untrusted certs). Remove the line for real certificates
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# cloudflare (default), route53, digitalocean, hetzner, ovh, porkbun, or any code from
# https://doc.traefik.io/traefik/https/acme/#providers (others need their variables added to docker-compose.yml)
ACME_DNS_PROVIDER=cloudflare
# Fill in only the block for your provider:
CF_DNS_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_HOSTED_ZONE_ID=
# DO_AUTH_TOKEN=
# HETZNER_API_TOKEN=
# OVH_ENDPOINT=ovh-eu
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# PORKBUN_API_KEY=
# PORKBUN_SECRET_API_KEY=

# ---------------------------------------------------------------- Wildcard certificate (optional)
# One Let's Encrypt certificate for WILDCARD_DOMAIN and *.WILDCARD_DOMAIN. See "Wildcard certificate" in docs/guide.md.
# On a trusted stack: add wildcard to COMPOSE_PROFILES, and gateway-acme keeps it (uses ACME_EMAIL, required,
# and CF_DNS_API_TOKEN from above). On a DMZ stack: set only WILDCARD_DOMAIN; its certificate is pushed to it.
# WILDCARD_DOMAIN=example.com
# CF_ZONE_ID=
# On the trusted stack, for a DMZ stack's certificate: add wildcard-remote to COMPOSE_PROFILES.
# gateway-acme-remote then pushes it over SSH and puts it on a Palo Alto firewall (SSL Inbound Inspection).
# REMOTE_SSH_TARGET=wildcard-push@192.0.2.10
# REMOTE_WILDCARD_DOMAIN=
# PANOS_HOST=192.0.2.1
# PANOS_USER=gateway-acme
# PANOS_PASS=
# PANOS_CERTNAME=gateway-wildcard
# PANOS_CA_FILE=
# PANOS_TLS_VERIFY=true

# ---------------------------------------------------------------- Google sign-in (optional)
# sso starts oauth2-proxy and turns sign-in on in the manager; wildcard starts gateway-acme (above).
# Comma-separated, e.g. sso,wildcard. Leave empty for neither
COMPOSE_PROFILES=
# The domain the sign-in cookie covers. Apps with sign-in must be under it; it must be in ALLOWED_DOMAINS.
# Sign-in itself happens at auth.<SSO_DOMAIN>, or SSO_AUTH_HOST below (Google's redirect URI: https://<that name>/oauth2/callback)
SSO_DOMAIN=
# Who may sign in is set in the manager, under Settings
# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type Web application)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# The cookie secret is made by the manager; nothing to set.
# Two stacks under the same SSO_DOMAIN (e.g. one at home, one in a DMZ): give each its own sign-in page
# and cookie name, and add both https://<SSO_AUTH_HOST>/oauth2/callback URIs to the Google client.
# SSO_AUTH_HOST=auth-home.example.com
# OAUTH_COOKIE_NAME=_oauth2_proxy_home
# Only to share ONE sign-in between stacks: the same random value on each (openssl rand -base64 32 | tr -- '+/' '-_').
# Anyone who has it can forge a sign-in on all of them, so never share it with a less trusted stack.
# OAUTH_COOKIE_SECRET=
# Certificate for the sign-in page: internal (devices need the root certificate), letsencrypt
# (any device; needs Let's Encrypt above, with credentials for SSO_DOMAIN's DNS zone) or wildcard (needs WILDCARD_DOMAIN)
SSO_AUTH_CERT=internal
# SSO_ENABLED=false
# SSO_AUTH_URL=http://oauth2-proxy:4180
