# Copy to .env for plain `docker compose`, or enter these as stack environment variables in
# Portainer / Dockhand. Never commit the filled-in file (.env is in .gitignore).

# ---------------------------------------------------------------- required
# The manager GUI and the Traefik dashboard (/dashboard/). Must be inside ALLOWED_DOMAINS.
MANAGER_FQDN=traefik.lab.example.com
# Apps can only use names under these domains (comma-separated)
ALLOWED_DOMAINS=lab.example.com
# Your LAN. The manager, and apps with "LAN only" ticked, only answer clients from here
LAN_CIDRS=192.168.1.0/24

# ---------------------------------------------------------------- host
# This host's LAN IP. App names should resolve to it; the DNS check warns when they don't
HOST_IP=192.168.1.10
TZ=UTC
# Host folder for config, certs, data and logs
TM_ROOT=/opt/traefik
# Host folder holding intermediate/ (cert + key) and root/ (root cert only)
PKI_DIR=/opt/traefik/pki
# Break-glass access to the manager that bypasses Traefik. Use <lan-ip>:8090 to listen on one address
BREAK_GLASS_PORT=8090
# Docker network shared with your apps (create it once: docker network create proxy)
PROXY_NETWORK=proxy

# ---------------------------------------------------------------- internal CA
# Nothing to do: on first start the manager creates a CA for ALLOWED_DOMAINS in PKI_DIR.
# Optional: a password to encrypt the CA key with (needed on every start once set)
CA_KEY_PASSWORD=
# To use a CA you already have, put it in PKI_DIR and name the files here
CA_CERT_FILE=intermediate_ca.crt
CA_KEY_FILE=intermediate_ca_key
ROOT_CA_FILE=root_ca.crt
# true (default), false, or force (create a new CA even though apps hold certs from an old one)
CA_AUTO_CREATE=true

# ---------------------------------------------------------------- manager image
# Pin to a release (e.g. 1.0.0) to choose when you upgrade
TM_VERSION=latest
# TM_IMAGE=ghcr.io/gjerdingc/traefik-manager

# ---------------------------------------------------------------- GUI login (recommended)
# htpasswd entries, e.g. from: htpasswd -nB me   (in .env, write each $ as $$)
BASIC_AUTH_USERS=

# ---------------------------------------------------------------- Let's Encrypt (optional)
LETSENCRYPT_ENABLED=false
ACME_EMAIL=
# Staging while testing (untrusted certs). Remove the line for real certificates
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# cloudflare (default), route53, digitalocean, hetzner, ovh, porkbun, or any code from
# https://doc.traefik.io/traefik/https/acme/#providers (others need their variables added to docker-compose.yml)
ACME_DNS_PROVIDER=cloudflare
# Fill in only the block for your provider:
CF_DNS_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_HOSTED_ZONE_ID=
# DO_AUTH_TOKEN=
# HETZNER_API_TOKEN=
# OVH_ENDPOINT=ovh-eu
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# PORKBUN_API_KEY=
# PORKBUN_SECRET_API_KEY=

# ---------------------------------------------------------------- Google sign-in (optional)
SSO_ENABLED=false
SSO_DOMAIN=
# SSO_AUTH_URL=http://oauth2-proxy:4180
